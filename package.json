{
  "name": "react-vite-template",
  "private": true,
  "version": "1.0.0",
  "description": "React Vite Template",
  "keywords": [
    "React",
    "Vite",
    "Typescript",
    "SCSS",
    "ESLint",
    "Stylelint",
    "Prettier",
    "BEM"
  ],
  "author": {
    "name": "Anton Limar",
    "email": "antonreal93@gmail.com"
  },
  "repository": "github:antonlimar/react-vite-template",
  "bugs": "https://github.com/antonlimar/react-vite-template/issues",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "stylelint": "stylelint 'src/**/*.scss'",
    "preview": "vite preview",
    "prepare": "husky",
    "format": "prettier . --write"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@eslint/js": "^9.39.5",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "bem-cn": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "rolldown": "^1.2.10",
    "sass": "^1.105.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,mjs}": [
      "prettier --write",
      "eslint"
    ],
    "**/*.scss": [
      "prettier --write",
      "stylelint"
    ]
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "unrs-resolver@1.12.2": true
  }
}
